*.tmp
*.bak
*.swp
*.swo
*~
tmp/
temp/


# =========================
# Jupyter Notebooks (generated output)
# =========================

*.ipynb
!docs/**/*.ipynb


# =========================
# ArgoCD / Helm local overrides
# =========================

argocd/local-values.yaml
*-local.yaml
*-override.yaml


